# PostgreSQL Database Credentials
POSTGRES_DB=controltower
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_production_password_change_me

# JWT Authentication Secret Key (Minimum 32-character high entropy key)
JWT_SECRET=super_secret_jwt_signing_key_production_32bytes_min

# Spring AI / Google Gemini API Key (Optional for RAG / LLM multi-agent reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Environment Settings
SPRING_PROFILES_ACTIVE=prod
PORT=8080
